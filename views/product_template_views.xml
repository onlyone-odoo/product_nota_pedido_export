<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="DATOS NOTA DE PEDIDO">
                    <group>
                        <field name="np_rubro"/>
                        <field name="np_nombre_rubro"/>
                        <field name="np_familia"/>
                        <field name="np_codigo_area"/>
                        <field name="np_nombre_area"/>
                        <field name="np_precio_publico_moneda"/>
                        <field name="np_precio_mayorista_moneda"/>
                        <field name="np_porcentaje_iva"/>
                        <field name="np_unidad_medida"/>
                        <field name="np_nombre_foto"/>
                        <field name="np_codigo_barra"/>
                        <field name="np_moneda"/>
                        <field name="np_precio_publico_dolar" readonly="1"/>
                        <field name="np_precio_mayorista_dolar" readonly="1"/>
                        <field name="np_cotizacion"/>
                        <field name="np_costo"/>
                        <field name="np_pto_pedido"/>
                        <field name="np_url_web"/>
                        <field name="np_ultimo_cambio_costo"/>
                        <field name="np_observaciones"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>