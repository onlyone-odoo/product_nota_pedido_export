<!-- views/export_ndp_wizard_views.xml -->
<odoo>
    <record id="view_export_ndp_wizard_form" model="ir.ui.view">
        <field name="name">export.ndp.wizard.form</field>
        <field name="model">export.ndp.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar CSV para NDP">
                <group>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="generate_csv" string="Generar CSV" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_export_ndp_wizard" model="ir.actions.act_window">
        <field name="name">Exportar CSV NDP</field>
        <field name="res_model">export.ndp.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_export_ndp_wizard"
              name="Exportar CSV NDP"
              parent="stock.menu_stock_config_settings"
              action="action_export_ndp_wizard"
              sequence="10"/>
</odoo>